# default.lambda —— P5/P6 行为 DSL 示例（全局默认行为）
#
# 结构：def（命名行为，可组合复用）+ plan（运行时入口）
# 原语：move dx dy / move north / speak target text / remember key text / ask-llm "prompt"
#       算术：add / mul / succ / sqr    比较：eq / lt / gt / le / ge
#       感知：self / closest / dist-to / name-of / direction-of
# 语法：lambda（λ name. body）/ let / if expr then expr else expr / 应用（rator rand…）
#       / 序列 { ; } / 整数 / 字符串 / 名字 / 方向（north/east/south/west）
#
# 约定：
#   - plan 直接内联引用自由变量 dx/dy（运行时由 LLM Oracle 决定方向并注入环境），
#     不要写成 λdx. λdy. 的形式；
#   - onMeet 是相遇对话的 λ 行为（参数 other 为对方 Agent），有则启用、无则回退内置对话；
#   - 若某 Agent 名对应 alice.lambda / bob.lambda，该 Agent 用其文件，否则用本文件；
#   - P6：if 真值遵循 Scheme 风格（仅 #f 为假，0/""/AgentRef 皆真）；感知原语查询
#     每 tick 注入的只读世界快照，"感知不到/无对象"返回 #f。

greet   = λ other. (speak other "你好，很高兴遇见你")
persona = λ other. (remember "met" "遇见了伙伴")
onMeet  = λ other. { greet other; persona other }

# P6 示例：感知范围内有伙伴时说话，否则按 LLM 方向移动（去掉下行注释即可启用）
# plan = if (closest) then (speak (closest) "我看到你了") else { remember "goal" "向前探索"; move dx dy }

plan = { remember "goal" "向前探索"; move dx dy }
